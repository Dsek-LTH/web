{
  "name": "dsek-web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prepare": "svelte-kit sync && pnpm paraglide",
    "ci-check": "concurrently 'pnpm:lint --max-warnings 0' 'pnpm:format' 'pnpm:test' 'pnpm:check --fail-on-warnings' 'pnpm:check-translations' --prefix-colors 'auto' --group",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "pm2 start prod/ecosystem.config.cjs --no-daemon",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "pnpm test:unit",
    "test:integration": "playwright test",
    "test:unit": "vitest run --retry 2",
    "migrate": "cd backend && go tool migrate up",
    "seed": "cd backend && go tool seed",
    "generate:api": "vite-node dev/generate_api_types.ts",
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/translations/paraglide",
    "check-translations": "./dev/check_translations.sh"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.5.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@inlang/paraglide-js": "2.9.1",
    "@internationalized/date": "^3.12.1",
    "@lucide/svelte": "^0.561.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-node": "^5.4.0",
    "@sveltejs/kit": "^2.63.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/table-core": "^8.21.3",
    "@types/node": "^22.10.1",
    "@types/nodemailer": "^6.4.17",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "bits-ui": "^2.18.0",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "embla-carousel-svelte": "^8.6.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^3.13.0",
    "formsnap": "^2.0.1",
    "globals": "^15.13.0",
    "husky": "^9.1.7",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "svelte": "^5.56.3",
    "svelte-check": "^4.3.4",
    "sveltekit-flash-message": "^2.4.6",
    "sveltekit-superforms": "^2.30.1",
    "tailwind-merge": "^3.3.1",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.1.12",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.3.8",
    "typescript": "^5.7.2",
    "vaul-svelte": "1.0.0-next.7",
    "vite": "^7.3.7",
    "vite-node": "^5.3.0",
    "vitest": "^4.1.12",
    "vitest-mock-extended": "^2.0.2",
    "zod": "^4.3.5"
  },
  "type": "module",
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.67.3",
    "@opentelemetry/exporter-trace-otlp-http": "^0.209.0",
    "@opentelemetry/sdk-node": "^0.209.0",
    "@preact/signals": "^2.8.2",
    "@schedule-x/calendar": "^3.0.0",
    "@schedule-x/calendar-controls": "^4.3.1",
    "@schedule-x/current-time": "^4.3.1",
    "@schedule-x/event-modal": "^4.3.1",
    "@schedule-x/events-service": "^4.3.1",
    "@schedule-x/scroll-controller": "^4.3.1",
    "@schedule-x/svelte": "^3.0.0",
    "@schedule-x/theme-default": "^3.0.0",
    "dayjs": "^1.11.19",
    "express": "^4.22.3",
    "ics": "^3.8.1",
    "import-in-the-middle": "^2.0.1",
    "isomorphic-dompurify": "^2.18.0",
    "markdown-to-txt": "^2.0.1",
    "marked": "^15.0.3",
    "minecraft-server-ping": "^0.3.3",
    "mode-watcher": "^1.1.0",
    "nodemailer": "^6.9.16",
    "preact": "^10.29.0",
    "prom-client": "^14.2.0",
    "simple-icons": "^15.21.0",
    "svelte-easy-crop": "^3.0.1",
    "temporal-polyfill": "0.3.0",
    "uuid": "^11.0.3"
  },
  "engines": {
    "node": "<=26"
  },
  "packageManager": "pnpm@9.14.4",
  "pnpm": {
    "patchedDependencies": {
      "devalue@5.8.1": "patches/devalue@5.8.1.patch"
    }
  }
}
