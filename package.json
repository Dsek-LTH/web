{
  "name": "dsek-web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prepare": "svelte-kit sync && zenstack generate && prisma generate && pnpm paraglide && pnpm snaplet-seed generate",
    "setup-dev": "vite-node dev/setup.ts",
    "ci-check": "concurrently 'pnpm:lint --max-warnings 0' 'pnpm:format' 'pnpm:test' 'pnpm:check --fail-on-warnings' 'pnpm:check-translations' --prefix-colors 'auto' --group",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "pm2 start prod/ecosystem.config.cjs --no-daemon",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "pnpm test:unit",
    "test:integration": "playwright test",
    "test:unit": "vitest run --retry 2",
    "generate": "zenstack generate && prisma generate",
    "migrate": "zenstack generate && prisma migrate dev && snaplet-seed sync",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:seed": "prisma migrate deploy && prisma db seed",
    "seed": "prisma db seed",
    "seed:documents": "vite-node dev/seed-documents.ts",
    "seed:documents:clean": "vite-node dev/seed-documents.ts --clean",
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/translations/paraglide",
    "check-translations": "./dev/check_translations.sh"
  },
  "zenstack": {
    "schema": "src/database/schema.zmodel"
  },
  "prisma": {
    "schema": "src/database/prisma/schema.prisma",
    "seed": "vite-node src/database/seed/main.ts"
  },
  "@snaplet/seed": {
    "config": "src/database/seed/seed.config.ts"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.1",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "^10.6.0",
    "@inlang/paraglide-js": "^2.29.3",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.66.0",
    "@playwright/test": "^1.64.1",
    "@snaplet/copycat": "^5.1.0",
    "@snaplet/seed": "0.98.0",
    "@sveltejs/adapter-node": "^5.4.0",
    "@sveltejs/kit": "^2.63.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/table-core": "^8.21.3",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@zenstackhq/openapi": "^2.10.0",
    "bits-ui": "^2.20.3",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "embla-carousel-svelte": "^8.6.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "formsnap": "^2.1.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^6.0.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-eslint-parser": "^1.10.0",
    "sveltekit-flash-message": "^3.0.0",
    "sveltekit-superforms": "^3.1.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vaul-svelte": "1.0.0-next.7",
    "vite": "^7.3.7",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.5",
    "vitest-mock-extended": "^5.1.1",
    "zenstack": "^2.10.0",
    "zod": "^4.6.7"
  },
  "type": "module",
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@auth/sveltekit": "^1.11.3",
    "@opentelemetry/auto-instrumentations-node": "^0.67.3",
    "@opentelemetry/exporter-trace-otlp-http": "^0.209.0",
    "@opentelemetry/sdk-node": "^0.209.0",
    "@preact/signals": "^2.8.2",
    "@prisma/client": "^6.0.1",
    "@prometheus-io/client": "^0.16.1",
    "@schedule-x/calendar": "^3.0.0",
    "@schedule-x/calendar-controls": "^4.3.1",
    "@schedule-x/current-time": "^4.3.1",
    "@schedule-x/event-modal": "^4.3.1",
    "@schedule-x/events-service": "^4.3.1",
    "@schedule-x/scroll-controller": "^4.3.1",
    "@schedule-x/svelte": "^3.0.0",
    "@schedule-x/theme-default": "^3.0.0",
    "@shlinkio/shlink-js-sdk": "^1.3.0",
    "@zenstackhq/runtime": "^2.10.0",
    "@zenstackhq/server": "^2.10.0",
    "dayjs": "^1.11.23",
    "expo-server-sdk": "^8.0.0",
    "express": "^4.22.3",
    "ics": "^3.12.1",
    "import-in-the-middle": "^2.0.1",
    "isomorphic-dompurify": "^4.6.0",
    "markdown-to-txt": "^2.0.1",
    "marked": "^18.1.2",
    "meilisearch": "^0.62.0",
    "minecraft-server-ping": "^0.3.4",
    "minio": "^8.0.7",
    "mode-watcher": "^1.1.0",
    "nodemailer": "^10.3.1",
    "preact": "^10.29.0",
    "sharp": "^0.35.5",
    "simple-icons": "^16.36.0",
    "svelte-easy-crop": "^5.0.1",
    "temporal-polyfill": "0.3.0",
    "uuid": "^14.0.3",
    "vite-plugin-cjs-interop": "^2.1.6"
  },
  "engines": {
    "node": "^24"
  },
  "packageManager": "pnpm@12.16.1"
}
