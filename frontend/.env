# Local development settings for the SvelteKit app. Tracked on purpose: there
# are no real secrets here, and it saves copying an example file. Deployments
# set their own values. Variables prefixed with PUBLIC are available in the
# client.

# GO BACKEND
# PUBLIC because universal (+page.ts) loads call the API from the browser too.
PUBLIC_GO_BACKEND_URL=http://localhost:8090

# FILE STORAGE
# Where the MinIO buckets are served from, for building file links.
PUBLIC_MINIO_BASE_URL=https://files-sandbox.dsek.se
PUBLIC_BUCKETS_DOCUMENTS="documents"
PUBLIC_BUCKETS_FILES="files"

# YRKA
# Used to send emails for "yrkanden".
EMAIL_YRKA_USER=
EMAIL_YRKA_PASS=
SMTP_HOST=
SMTP_PORT=

# MEDIAWIKI
MEDIAWIKI_ENDPOINT=https://dwiki.se/api.php
# Setup in https://wiki.dsek.se/wiki/Special:BotPasswords
MEDIAWIKI_USERNAME=
MEDIAWIKI_PASSWORD=

# MINECRAFT
MINECRAFT_URL=minecraft://minecraft.dsek.se

# MISCELLANEOUS
MOCK_IS_APP=false     # if true, will pretend like all traffic is coming from the app to test how custom app design looks
REQUEST_LOGGING=false # will log all requests in production
PUBLIC_DISABLE_SSR_GLOBALLY=false

# TRACING
PUBLIC_OTLP_TRACE_EXPORT_URL=http://localhost:4318/v1/traces
PUBLIC_OTLP_SERVICE_NAME="dsek.se"
