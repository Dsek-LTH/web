{
  "name": "dsek-web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prepare": "svelte-kit sync && pnpm paraglide",
    "ci-check": "concurrently 'pnpm:lint --max-warnings 0' 'pnpm:format' 'pnpm:test' 'pnpm:check --fail-on-warnings' 'pnpm:check-translations' --prefix-colors 'auto' --group",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "PORT=4173 node --env-file=.env prod/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "pnpm test:unit",
    "test:integration": "playwright test",
    "test:unit": "vitest run --retry 2",
    "generate:api": "vite-node dev/generate_api_types.ts",
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/translations/paraglide",
    "check-translations": "./dev/check_translations.sh"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^2.29.3",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.66.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-node": "^5.4.0",
    "@sveltejs/kit": "^2.63.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/table-core": "^8.21.3",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "bits-ui": "^2.20.3",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "embla-carousel-svelte": "^8.6.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "formsnap": "^2.1.0",
    "globals": "^17.14.0",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-eslint-parser": "^1.10.0",
    "sveltekit-flash-message": "^2.4.6",
    "sveltekit-superforms": "^2.30.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vaul-svelte": "1.0.0-next.7",
    "vite": "^7.3.7",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.5",
    "vitest-mock-extended": "^5.1.1",
    "zod": "^4.6.7"
  },
  "type": "module",
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@preact/signals": "^2.8.2",
    "@prometheus-io/client": "^0.16.1",
    "@schedule-x/calendar": "^3.0.0",
    "@schedule-x/calendar-controls": "^4.3.1",
    "@schedule-x/current-time": "^4.3.1",
    "@schedule-x/event-modal": "^4.3.1",
    "@schedule-x/events-service": "^4.3.1",
    "@schedule-x/scroll-controller": "^4.3.1",
    "@schedule-x/svelte": "^3.0.0",
    "@schedule-x/theme-default": "^3.0.0",
    "dayjs": "^1.11.23",
    "express": "^5.3.0",
    "ics": "^3.12.1",
    "import-in-the-middle": "^3.5.3",
    "isomorphic-dompurify": "^4.6.0",
    "markdown-to-txt": "^2.0.1",
    "marked": "^18.1.2",
    "minecraft-server-ping": "^0.3.4",
    "mode-watcher": "^1.1.0",
    "nodemailer": "^10.3.1",
    "preact": "^10.29.0",
    "simple-icons": "^16.36.0",
    "svelte-easy-crop": "^5.0.1",
    "temporal-polyfill": "0.3.0",
    "uuid": "^14.0.3"
  },
  "engines": {
    "node": "^24"
  },
  "packageManager": "pnpm@12.16.1",
  "pnpm": {}
}
