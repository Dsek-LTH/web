# Local development settings for the Go backend. Tracked on purpose: there are
# no real secrets here, and it saves copying an example file. Deployments set
# their own values.

# DATABASE
# The local dsek-db container (docker compose up -d from the repo root).
POSTGRES_URL="postgresql://postgres:postgres@localhost:5432/dsek?schema=public"

# AUTH
# The OIDC login against Authentik (internal/auth).
AUTH_SECRET="4e0b5eed97d12748be91415ac2716b9e91deb57198c7b3662afe7f1649089b54" # required, generate a 32-bit random string, for example with openssl rand -hex 32
AUTH_AUTHENTIK_CLIENT_ID="SvRybUTCGqhNiw2Y3gn1wqt0YxpjW2sv9fbPsUaP"
AUTH_AUTHENTIK_CLIENT_SECRET="" # public dev client, only allows redirect to localhost
PUBLIC_AUTH_AUTHENTIK_ISSUER="https://auth.dsek.se/application/o/dev/"
# Where login redirects back to (the SvelteKit app's origin), and the domain
# the session cookie is scoped to so both origins get it despite the
# different ports.
PUBLIC_FRONTEND_URL="http://localhost:5173"
AUTH_COOKIE_DOMAIN="localhost"
# This API's own URL; the OIDC callback is under it.
PUBLIC_GO_BACKEND_URL=http://localhost:8090

# Treats every request as signed in with every policy (internal/auth/mock.go),
# so every contributor gets a working admin dev environment without an
# Authentik account. A real deployment must never set this to true.
AUTH_MOCK=true

# FILE STORAGE
# The MinIO file server. Without credentials, set STORAGE_MOCK=true.
MINIO_ROOT_USER=     # <|
MINIO_ROOT_PASSWORD= # <| Do not forget to put the values here! Otherwise it wont work!
MINIO_ENDPOINT=files-sandbox.dsek.se
MINIO_PORT=443
MINIO_USE_SSL=true
PUBLIC_MINIO_BASE_URL=https://files-sandbox.dsek.se

PUBLIC_BUCKETS_DOCUMENTS="documents"
PUBLIC_BUCKETS_FILES="files"
PUBLIC_BUCKETS_MEMBERS="members"
PUBLIC_BUCKETS_ALBUMS="albums"

# LINK SHORTENER
# Used to connect to the Shlink link shortener service.
SHLINK_API_KEY=
SHLINK_ENDPOINT=https://link.dsek.se

# SEARCH
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=masterKey
# Extracts text from PDFs for the document indexes.
POPPLER_SERVER_URL=http://localhost:8800
# Lets a cron job start a search-index rebuild (POST /search/sync/password).
SYNC_PASSWORD=password123

# TRACING
# Off unless an endpoint is set. Locally: `docker compose --profile tracing
# up -d` (Jaeger, UI on http://localhost:16686), then uncomment this.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_SERVICE_NAME=dsek-backend

# LOGGING
# LOG_FORMAT=json
# LOG_LEVEL=debug
